# Public API base URL consumed by src/config/env.ts.
# Web target and simulators can use localhost.
# Physical devices must point at the dev machine's LAN IP (same network), e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:7000/api
EXPO_PUBLIC_API_URL=http://localhost:7000/api

# Base URL for product images.
# Dev default (unset): http://localhost:7000/images/products — gateway proxy ao bucket MinIO `products`.
# Physical devices: usar LAN IP, ex.: EXPO_PUBLIC_IMAGE_BASE_URL=http://192.168.1.42:7000/images/products
# Prod: apontar para CDN, ex.: EXPO_PUBLIC_IMAGE_BASE_URL=https://cdn.dominio.com/images/products
EXPO_PUBLIC_IMAGE_BASE_URL=
