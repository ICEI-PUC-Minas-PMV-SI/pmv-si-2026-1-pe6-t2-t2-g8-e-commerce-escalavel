# Public API base URL consumed by src/config/env.ts.
# Web target and simulators can use localhost.
# Android Emulator must use 10.0.2.2 to access host machine.
# Physical devices must use LAN IP (same network), e.g. http://192.168.x.x:7000/api

EXPO_PUBLIC_API_URL=http://10.0.2.2:7000/api

# Base URL for product images.
# Dev default (Docker local): use same host mapping
# Android Emulator -> 10.0.2.2
# Physical devices -> LAN IP
# Prod -> CDN

EXPO_PUBLIC_IMAGE_BASE_URL=http://10.0.2.2:7000/images/products