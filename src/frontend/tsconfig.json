{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["*.tsx", "*.ts", "components", "contexts", "services", "catalog", "user"],
  "exclude": ["catalog/CatalogRoutes.jsx", "catalog/CatalogEntry.jsx", "user/UserRoutes.tsx", "user/UserEntry.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
